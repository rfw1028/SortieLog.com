                    function isValidDate(value) {
                        return value instanceof Date && !isNaN(value);
                     }

                     var airplaneValue = "";
					 var isoDate = "";

        function go() {
           airplaneValue = document.getElementById('airplane').value;
           var dateValue = document.getElementById('datetimepicker').value;

          var parsedDate = new Date(dateValue);
          isoDate = parsedDate.toISOString();  // Required if your date is not in ISO format
            
            const token = document.querySelector('meta[name="RequestVerificationToken"]').getAttribute('content');

            fetch('/AddFlights?handler=ProcessData', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ 
                   airplane: airplaneValue,
                   flightDateTime: isoDate               
                })
            })
            .then(response => {
                if (!response.ok) throw new Error("Network response was not ok");
                return response.json();
            })
            .then(data => {
                try{
					 //document.getElementById('responseMessage').innerText = data.message;
                     addMarkers(data.message);                   
                }
                catch(err){
                    // document.getElementById('responseMessage').innerText = data.message;
                  document.getElementById('responseMessage').innerText = err.message;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('responseMessage').innerText = "An error occurred.";
            });
        }

            let altArray = [];
            let altTimeArray = [];
            let markers = [];
            let latArray = [];
            let lngArray = [];
            let timeArray = [];
            let polyLines = [];
            let infoWindows = [];
            let Points = [];
			let wxObs = [];

            function clearMarkers() {
                // Loop through the markers array and set each marker's map to null
                for (let i = 0; i < markers.length; i++) {
                    markers[i].setMap(null);
                    infoWindows[i].close(); // Close the info window
                }
                infoWindows = []; // Clear the infoWindows array
                markers = []; // Clear the markers array
            }

            function clearpolyLines() {
                for (let i = 0; i < polyLines.length; i++) {
                    polyLines[i].setMap(null);
                }
                polyLines = [];
            }

            function clearAll() {
                clearMarkers();
                clearpolyLines();
                latArray = [];
                lngArray = [];
                timeArray = [];
                altArray = [];
                return true;               
            }

     

        function addMarkers(data){
