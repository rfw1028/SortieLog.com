                               if(document.getElementById("end").value!=""){
                                   var fTime = Date.parse(document.getElementById("end").value) - Date.parse(document.getElementById("start").value);
                                  var secs = fTime/1000;
                                  var mins = secs / 60;
                                 document.getElementById("fTime").innerHTML = mins;
                               }
                            }
                     });

                      flatpickr("#end", {
                           enableTime: true,
                            time_24hr: true,
                            dateFormat: "m-d-Y H:i",
