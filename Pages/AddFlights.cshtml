			if(markers.length>0){
				clearAll();
			}
            document.getElementById("save").style.display = 'none';


            const root = JSON.parse(data);
             const flight = root.flight;             
            
            var llb = new google.maps.LatLngBounds();

              const DateTime = luxon.DateTime;
              var Points = [];

            if (flight.positions.length>0) {
                
               Points = flight.positions;

                map.setCenter({ lat: Points[0].lat, lng: Points[0].lon });
                map.setZoom(14);

				var dts = new Date(Points[0].timestamp);
				var dte = new Date(Points[Points.length-1].timestamp);
				var diff = (dte - dts) / 60000;				

                var incr = Math.floor(Points.length / Math.floor(diff));
                
                altTimeArray.length = 0;
                timeArray.length = 0;
                altArray.length = 0;

                for (var i = 0; i < Points.length; i++) {  
                     latArray.push(Points[i].lat);
                     lngArray.push(Points[i].lon);

                     if(Points[i].alt>0){
                        altTimeArray.push(Points[i].timestamp);
                        altArray.push(Points[i].alt);
                     }

                    llb.extend(new google.maps.LatLng(Points[i].lat, Points[i].lon));
                }

                for (var i = 0;i < Points.length; i+=incr){
                       var pin = document.createElement("div");
                        pin.className = "track";

                        var content = `Hdg: ${Points[i].track}°&nbsp;`;
                        content += `Alt: ${Points[i].alt}' agl<br />`;
                        
                        content += `Spd: ${Points[i].gspeed} kts.&nbsp;`;   

                        var udte = DateTime.fromISO(Points[i].timestamp, { zone: 'utc' });
                        var dte = udte.setZone('local');
                        content += `Time: ${dte.toFormat('HHmm')}`;
                        
                        timeArray.push(dte);

                        const c182 = "m 32,8.4 0.4,0.7 0.2,0.8 5.2,0 0,0.2 -5.1,0.1 0.1,0.5 0.7,0 0.6,0.2 0.3,0.4 0.2,0.7 0.5,3.9 0.1,3.4 11.1,0 15.6,0.7 0.6,0.4 0.3,0.8 0,5.1 -16.8,2.3 -10.8,0 -2.1,16.1 8.3,1.1 0.5,0.4 0.1,1.5 0,1.2 -0.1,1.3 -0.5,0.3 -8.1,1.4 -0.8,-2.1 -0.2,1.7 -0.1,3.2 -0.2,0.9 -0.2,-0.9 -0.1,-3.2 -0.2,-1.7 -0.8,2.1 -8.1,-1.4 -0.5,-0.3 -0.1,-1.3 0,-1.2 0.1,-1.5 0.5,-0.4 8.3,-1.1 -2.1,-16.1 -10.8,0 -16.8,-2.3 0,-5.1 0.3,-0.8 0.6,-0.3 15.6,-0.8 11.1,0 0.1,-3.4 0.5,-3.9 0.2,-0.7 0.3,-0.4 0.6,-0.2 0.7,0 0.1,-0.5 -5.2,-0.1 0,-0.2 5.3,0 0.2,-0.8 z";
                        const b17 = "m 32,0.5 0.5,0.2 0.4,0.5 0.6,1.4 0.7,1.9 0.4,2.4 0.3,3.1 0,9 3.7,0 0.4,-0.5 0,-1.3 0.1,-1.2 0.1,-0.9 -2.6,0 0,-0.1 2.6,0 0.2,-0.6 0.2,-0.6 0.2,-0.2 0.2,-0.1 0.2,0.1 0.2,0.2 0.2,0.6 0.2,0.6 2.6,0 0,0.1 -2.6,0 0.1,0.9 0.1,1.2 0,1.4 0.6,0.3 4.5,0.1 0.4,-0.5 0,-1 0.1,-1.2 0.1,-0.8 -2.6,0 0,-0.1 2.6,0 0.2,-0.7 0.2,-0.5 0.2,-0.2 0.2,-0.1 0.2,0.1 0.2,0.2 0.2,0.5 0.2,0.7 2.6,0 0,0.1 -2.6,0 0.1,0.8 0.1,1.2 0,1.1 0.4,0.4 8.9,0.3 0.2,0.2 0.1,1.2 0,1.7 -0.1,0.9 -0.3,0.2 -0.3,0.1 0,-0.3 -9.4,1.8 -0.1,0.4 -0.9,0.2 -0.1,-0.4 -6.3,1.2 -0.1,0.3 -0.9,0.2 -0.1,-0.3 -3.5,0.7 -1.1,0.9 0,10.6 -0.4,3.5 -0.4,2.6 8.5,2.5 0.2,0.3 0,1 -0.1,0.6 -9.5,1.2 -0.9,5.5 0,4.5 -0.1,0.3 -0.2,0.1 -0.2,-0.1 -0.1,-0.3 0,-4.5 -0.9,-5.5 -9.5,-1.2 -0.1,-0.6 0,-1 0.2,-0.3 8.5,-2.5 -0.4,-2.5 -0.4,-3.5 0,-10.6 -1.1,-0.9 -3.5,-0.7 -0.1,0.3 -0.9,-0.2 -0.1,-0.3 -6.3,-1.2 -0.1,0.4 -0.9,-0.2 -0.1,-0.4 -9.4,-1.8 0,0.3 -0.3,-0.1 -0.3,-0.2 -0.1,-0.9 0,-1.7 0.1,-1.2 0.2,-0.2 8.9,-0.3 0.4,-0.4 0,-1.1 0.1,-1.2 0.1,-0.9 -2.6,0 0,-0.1 2.6,0 0.2,-0.6 0.2,-0.5 0.2,-0.2 0.2,-0.1 0.2,0.1 0.2,0.2 0.2,0.5 0.2,0.6 2.6,0 0,0.1 -2.6,0 0.1,0.9 0.1,1.2 0,1 0.4,0.5 4.5,-0.1 0.6,-0.3 0,-1.5 0.1,-1.2 0.1,-0.9 -2.6,0 0,-0.1 2.6,0 0.2,-0.6 0.2,-0.5 0.2,-0.2 0.2,-0.1 0.2,0.1 0.2,0.2 0.2,0.5 0.2,0.6 2.6,0 0,0.1 -2.6,0 0.1,0.9 0.1,1.2 0,1.3 0.4,0.5 3.7,0 0,-9 0.3,-3.1 0.4,-2.4 0.7,-1.9 0.6,-1.4 0.4,-0.5 z ";
                       const parser = new DOMParser();
                        // A marker with a custom inline SVG.
                       var pinSvgString =  '<svg transform="rotate(' + Points[i].track + ')" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 64 64" fill="none">';
                                pinSvgString  +=  '<rect width="64" height="64" rx="16" fill="none"></rect><path d="' + c182 + '"  fill="#fdad18" stroke="#000000"></path></svg>';                        

                        var pinSvg = parser.parseFromString(pinSvgString, "image/svg+xml").documentElement;

                        pinSvg.style.width = "32px";
                        pinSvg.style.height = "32px";                        

                        let  infoWindow = new google.maps.InfoWindow({
                            content: content,                           
                        });                 

                       
                        let marker = new google.maps.marker.AdvancedMarkerElement({
                            position: { lat: Points[i].lat, lng: Points[i].lon, altitude: Points[i].alt },
                            map: map,
                            content: pinSvg,
                            collisionBehavior: "OPTIONAL_AND_HIDES_LOWER_PRIORITY",
                        });
                                          
                        google.maps.event.addListener(marker, 'click', function () {
                           infoWindow.open(map, this);
                        });

                        infoWindows.push(infoWindow);
                        markers.push(marker);                        
                       
                                            
                }

                  var flightPlanCoordinates = bspline(latArray, lngArray);

                  flightPath = new google.maps.Polyline({
                      path: flightPlanCoordinates,
                      geodesic: true,
                      strokeColor: "#FF0000",
                      strokeOpacity: 1.0,
                      strokeWeight: 4,
                  });

                  //polyLines.push(flightPath);
                  flightPath.setMap(map);
                  map.fitBounds(llb);

                  drawChart(altTimeArray, altArray);

				  addWeather();
            }
        }

        function bspline(lats, lons) {
              var i, t, ax, ay, bx, by, cx, cy, dx, dy, lat, lon, points;
              points = [];
              // For every point
              for (i = 2; i < lats.length - 2; i++) {
                  for (t = 0; t < 1; t += 0.2) {
                      ax = (-lats[i - 2] + 3 * lats[i - 1] - 3 * lats[i] + lats[i + 1]) / 6;
                      ay = (-lons[i - 2] + 3 * lons[i - 1] - 3 * lons[i] + lons[i + 1]) / 6;
                      bx = (lats[i - 2] - 2 * lats[i - 1] + lats[i]) / 2;
                      by = (lons[i - 2] - 2 * lons[i - 1] + lons[i]) / 2;
                      cx = (-lats[i - 2] + lats[i]) / 2;
                      cy = (-lons[i - 2] + lons[i]) / 2;
                      dx = (lats[i - 2] + 4 * lats[i - 1] + lats[i]) / 6;
                      dy = (lons[i - 2] + 4 * lons[i - 1] + lons[i]) / 6;
                      lat = ax * Math.pow(t + 0.1, 3) + bx * Math.pow(t + 0.1, 2) + cx * (t + 0.1) + dx;
                      lon = ay * Math.pow(t + 0.1, 3) + by * Math.pow(t + 0.1, 2) + cy * (t + 0.1) + dy;
                      points.push(new google.maps.LatLng(lat, lon));
                  }
              }
              return points;
        }

          function addWeather(){
			  document.getElementById("weather").value = "";
              
			  if(typeof Points !== 'undefined'){
                   const token = document.querySelector('meta[name="RequestVerificationToken"]').getAttribute('content'); 
                   
                   //alert("Start:" + timeArray[0] + " End:" + timeArray[timeArray.length-1]);

                   var diff = (timeArray[timeArray.length-1] - timeArray[0]) / 60000;

				   diff = Math.floor(diff);

                   fetch('/AddFlights?handler=GetWeather', {
                        method: 'POST',
                        headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
						latitude:latArray[0],
                        longitude:lngArray[0],
						starttime:timeArray[0],
						endtime:timeArray[timeArray.length-1],
                        points:diff
                        })
                   })
                    .then(response => {
                        if (!response.ok) throw new Error("Network response was not ok");
                        return response.json();
                    })
                    .then(data => {
                     try{

						 //document.getElementById("weather").value += data.message;

                        wxObs = JSON.parse(data.message);
                        //alert(wxObs.Observations.length);

                        for (var j = 0; j < wxObs.Observations.length; j++) {

                        infoWindows[j].setContent(infoWindows[j].getContent() + "<br />Wind Direction: " + wxObs.Observations[j].WindDir + "&nbsp; ");
                        infoWindows[j].setContent(infoWindows[j].getContent() + "Wind Speed: " + wxObs.Observations[j].WindSpd + "<br />");
                        infoWindows[j].setContent(infoWindows[j].getContent() + "Barometer: " + parseFloat(wxObs.Observations[j].Baro1).toFixed(2) + "<br />");
                        infoWindows[j].setContent(infoWindows[j].getContent() + "Temp: " + wxObs.Observations[j].Temp + "&deg;C&nbsp; ");
                        infoWindows[j].setContent(infoWindows[j].getContent() + "Dewpoint: " + wxObs.Observations[j].Dewpoint + "&deg;C");
                               
                        }
                                document.getElementById("weather").value += "Weather Added!";
								document.getElementById("save").style.display = 'inline';
              }
              catch(ex)
              {
                document.getElementById("weather").value += ex.message;
              }

                    })
                    .catch(error => {
                       document.getElementById("weather").value = "An error occurred.";
                    });     
              }
			  else
              {
				 alert("You must get a valid flight track first.");
			  }
          }      
          
          function saveFlight(){
              try{              
             	  
			  if(wxObs.length == 0){
                      alert("You must get a valid weather track first.");
                      return;
             };

              eventDate = new Date(timeArray[0]);	
			  startTime = new Date(timeArray[0]);			  
              endTime = new Date(timeArray[timeArray.length-1]);			  
              			 
			  const token = document.querySelector('meta[name="RequestVerificationToken"]').getAttribute('content');

			  fetch('/AddFlights?handler=SaveFlight', {
				  method: 'POST',
				  headers: {
					  'Content-Type': 'application/json'
				  },
				  body: JSON.stringify({					  
					  eventDate:eventDate, 
					  startTime:startTime,
					  endTime:endTime,
					  airplane: airplaneValue	  
				  })
			  })
			  .then(response => {
				  if (!response.ok) throw new Error("Network response was not ok");
				  return response.json();
			  })
			  .then(data => {
				  try{
					  document.getElementById('weather').value = data.message;
				  }
				  catch(err){
					  document.getElementById('weather').value = err.message;
				  }
			  })
			  .catch(error => {
				  console.error('Error:', error);
				  document.getElementById('weather').innerText = "An error occurred.";
			  });

              }catch(err){
                  alert(err.message);
              }
          }


          function showHideManFlt(){
                   try {
                                const fDiv = document.getElementById("manFlt");
                                const cDiv = document.getElementById("chart");

                                const isHidden = window.getComputedStyle(fDiv).display === "none";

                                 if (isHidden) {
                                        fDiv.style.display = "block";
                                        cDiv.style.display = "none";
                                 } else {
                                        fDiv.style.display = "none";
                                        cDiv.style.display = "block";
                                 }
                    } catch (ex) {
                            alert(ex.message);
                    }

          }
    </script>
</head>
<body>  
