       <input type="text" Placeholder="Airplane Registration #" id="airplane" /><hr />
        <button onclick="go()">Show Flight</button>   <hr />            
		<button id="save" style="display:none;" onclick="saveFlight()">Save Flight</button>
        <hr />
		<textarea id="weather" rows="8" cols="25"></textarea>
        <hr />
        <button id="showMF" onclick="showHideManFlt()">Add A Flight Manually</button>
    </div>
    <div id="map"></div>   
    <div id="chart"></div>
    <div id="manFlt">
        <p class="UserInfo">@Model.UserName</p><p class="UserInfo">@Model.UserEmail</p>
        <input type="text" id="start" placeholder="Select Flight Start Time" />
        <input type="text" id="end" placeholder="Select Flight End Time" />
        <p style="font-weight:900;color:white;font-face:candara;font-size:18px;">Flight Time <span  id="fTime"></span>&nbsp;minutes.</p>
        <input class="position" type="text" id="sLatLng" placeholder="Left Click Map For Flight Start Position" />
        <input class="position" type="text" id="eLatLng" placeholder="Right Click Map For Flight End Position" />
        </div>
</body>
