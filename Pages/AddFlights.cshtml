    <script>
          google.charts.load('current', { 'packages': ['corechart'] });
          var map = "";

          window.addEventListener('load', pgResized);
          window.addEventListener('resize', pgResized);

          var chartWide;
          var chartTop;
                         

            function pgResized() {
               
                chartWide = (window.innerWidth - 220) + "px";
                chartTop = (window.innerHeight - 260) + "px";                 
                chartHt = 195 + "px";
                document.getElementById("chart").style.height = chartHt;
                document.getElementById("chart").style.top = chartTop;
                document.getElementById("chart").style.width = chartWide;      
                document.getElementById("manFlt").style.top=chartTop;
                document.getElementById("manFlt").style.height = chartHt;
                document.getElementById("manFlt").style.width=chartWide;

               drawChart(timeArray, altArray);

            }

           
        function drawChart(times, alts) {          

                var data = new google.visualization.DataTable();
                data.addColumn('date', 'Time');
                data.addColumn('number', 'Altitude (ft)');

                for (var i = 0; i < times.length; i++) {
                    data.addRow();
                    data.setCell(i, 0, new Date(times[i]));
                    data.setCell(i, 1, alts[i]);
                }


               var options = {                   
                    title: 'Flight Profile',
                    curveType: 'function',
                    legend: { position: 'bottom' },
                    vAxis: { viewWindow: { min: 0 }},                  
                    width:"100%"
               }

                var chart = new google.visualization.LineChart(document.getElementById('chart'));
                    chart.draw(data, options);         

        }

                async function initMap() {
                    try{
                    var location = {lat: 44.488449095167645, lng: -88.13181425565789 }; // Default to KGRB
                     map = new google.maps.Map(document.getElementById('map'), {
                        zoom: 13,
                        center: location,
                          mapId: '942a3abf82be32c2'
                    });

                    google.maps.event.addListener(map, 'click', (e) =>{
                        const lat = e.latLng.lat().toFixed(6);   // get latitude as number
                        const lng = e.latLng.lng().toFixed(6);   // get longitude as number                        
                        document.getElementById('sLatLng').value = `${lat}, ${lng}`;
                    });
                    
                   google.maps.event.addListener(map, 'rightclick', (e) =>{
                        const lat = e.latLng.lat().toFixed(6);   // get latitude as number
                        const lng = e.latLng.lng().toFixed(6);   // get longitude as number
                         // put “lat,lng” into your text field
                        document.getElementById('eLatLng').value = `${lat}, ${lng}`;
