@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 >Welcome To SortieLog.Com</h1>
    <hr />
    <h2>This site allows pilots that fly ADS-B Out equipped airplanes to create an online logbook of their flights that depicts their flight track along with the weather conditions experienced during the course of the flight.  All that is needed is the Registration number ('N' number) of the airplane and the time and date of flight.</h2>
    <hr />
   <h4>Users must log-in using either a Google account or a Microsoft account</h4>
   <br />
   <hr />
    <h6>By logging in to this site you agree to the <a asp-page="/TermsOfService">Terms of Service</a> and that you have read and understand the <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></h6>    
</div>
